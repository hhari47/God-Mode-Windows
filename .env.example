# GodMode for Windows - Environment Configuration
# Copy this file to .env and fill in your values

# --- AI Provider Selection ('gemini' or 'grok') ---
AI_PROVIDER=gemini

# --- Google Gemini Settings ---
# Get your key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# --- xAI Grok Settings (Free tier: 1,000 requests/day) ---
# Get your key at: https://console.x.ai
GROK_API_KEY=your_grok_key_here
GROK_MODEL=grok-2-latest

# --- OCR Engine ---
# Windows 10/11 native OCR is enabled automatically (0 setup, 100% offline).
# Tesseract OCR is an optional fallback if you want an alternative engine:
# Download from: https://github.com/UB-Mannheim/tesseract/wiki
# Default Windows install path:
TESSERACT_PATH=C:\Program Files\Tesseract-OCR\tesseract.exe

# --- Signal Settings ---
# Blink duration in milliseconds (default: 200)
BLINK_DURATION_MS=200
# Enable/disable Caps Lock LED signaling (default: true)
ENABLE_LED_SIGNAL=true
# Enable/disable optional audible confirmation beep (default: false)
ENABLE_SOUND_SIGNAL=false

# --- Privacy ---
# Never log captured screen content (enforced, cannot be disabled)
LOG_SCREEN_CONTENT=false
