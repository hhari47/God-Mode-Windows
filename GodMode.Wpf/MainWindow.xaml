<Window x:Class="GodMode.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="GodMode — AI Question Solver" 
        Height="700" Width="1000"
        MinHeight="600" MinWidth="850"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Window.Resources>
        <!-- Modern Obsidian Theme Brushes -->
        <SolidColorBrush x:Key="BgWindow" Color="#090D16" />
        <SolidColorBrush x:Key="BgSidebar" Color="#0E131F" />
        <SolidColorBrush x:Key="BgCard" Color="#141A29" />
        <SolidColorBrush x:Key="BgCardHover" Color="#1C2436" />
        <SolidColorBrush x:Key="BgInput" Color="#0F1422" />
        <SolidColorBrush x:Key="BorderColor" Color="#232D42" />
        <SolidColorBrush x:Key="AccentBlue" Color="#38BDF8" />
        <SolidColorBrush x:Key="AccentGreen" Color="#10B981" />
        <SolidColorBrush x:Key="AccentAmber" Color="#F59E0B" />
        <SolidColorBrush x:Key="TextMain" Color="#F8FAFC" />
        <SolidColorBrush x:Key="TextDim" Color="#94A3B8" />

        <Style x:Key="NavBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource TextDim}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource BgCardHover}" />
                    <Setter Property="Foreground" Value="{StaticResource TextMain}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ActionBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource BgCard}" />
            <Setter Property="Foreground" Value="{StaticResource TextMain}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource BgCardHover}" />
                    <Setter Property="BorderBrush" Value="{StaticResource AccentBlue}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <!-- Outer Card Container -->
    <Border Background="{StaticResource BgWindow}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42" /> <!-- Custom Title Bar -->
                <RowDefinition Height="*" />   <!-- Body -->
                <RowDefinition Height="32" />  <!-- Status Bar -->
            </Grid.RowDefinitions>

            <!-- 1. Custom Title Bar -->
            <Grid Grid.Row="0" Background="{StaticResource BgSidebar}" MouseDown="TitleBar_MouseDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                    <TextBlock Text="⚡" FontSize="16" Foreground="{StaticResource AccentBlue}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock Text="GodMode" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextMain}" VerticalAlignment="Center" />
                    <Border Background="{StaticResource BgCard}" CornerRadius="4" Padding="6,2" Margin="8,0,0,0">
                        <TextBlock Text="v2.0 Standalone" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource AccentBlue}" />
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                    <Button Content="—" Width="32" Height="28" Style="{StaticResource NavBtnStyle}" Click="MinimizeBtn_Click" ToolTip="Minimize to Tray" HorizontalContentAlignment="Center" />
                    <Button Content="✕" Width="32" Height="28" Style="{StaticResource NavBtnStyle}" Click="CloseBtn_Click" ToolTip="Hide to Tray" HorizontalContentAlignment="Center" />
                </StackPanel>
            </Grid>

            <!-- 2. Main Body (Sidebar + Content View) -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Left Sidebar -->
                <Border Grid.Column="0" Background="{StaticResource BgSidebar}" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,1,0">
                    <StackPanel Margin="10,14,10,10">
                        <Button x:Name="NavWorkspaceBtn" Content="⚡ Workspace" Style="{StaticResource NavBtnStyle}" Click="NavWorkspace_Click" Margin="0,2" />
                        <Button x:Name="NavHistoryBtn" Content="📋 History &amp; Logs" Style="{StaticResource NavBtnStyle}" Click="NavHistory_Click" Margin="0,2" />
                        <Button x:Name="NavSettingsBtn" Content="⚙️ Settings" Style="{StaticResource NavBtnStyle}" Click="NavSettings_Click" Margin="0,2" />

                        <Separator Background="{StaticResource BorderColor}" Margin="0,16" />

                        <Border Background="{StaticResource BgCard}" CornerRadius="8" Padding="10">
                            <StackPanel>
                                <TextBlock Text="SHORTCUTS" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentBlue}" Margin="0,0,0,6" />
                                <TextBlock Text="Ctrl + Alt + X" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMain}" />
                                <TextBlock Text="Solve Selected Text" FontSize="10" Foreground="{StaticResource TextDim}" Margin="0,0,0,6" />
                                <TextBlock Text="Ctrl + Alt + O" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMain}" />
                                <TextBlock Text="Silent Screen OCR" FontSize="10" Foreground="{StaticResource TextDim}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Right View Container -->
                <Grid Grid.Column="1" Margin="16">
                    <!-- Workspace View -->
                    <Grid x:Name="WorkspaceView" Visibility="Visible">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="180" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Quick Actions Toolbar -->
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                            <Button Content="⚡ Solve Selected (Ctrl+Alt+X)" Style="{StaticResource ActionBtnStyle}" Click="SolveSelectedBtn_Click" Margin="0,0,8,0" />
                            <Button Content="📷 Screen OCR (Ctrl+Alt+O)" Style="{StaticResource ActionBtnStyle}" Click="ScreenOcrBtn_Click" Margin="0,0,8,0" />
                            <Button Content="📋 Paste &amp; Solve" Style="{StaticResource ActionBtnStyle}" Click="PasteAndSolveBtn_Click" Margin="0,0,8,0" />
                            <Button Content="🧹 Clear" Style="{StaticResource ActionBtnStyle}" Click="ClearBtn_Click" />
                        </StackPanel>

                        <!-- Input Question Box -->
                        <Border Grid.Row="1" Background="{StaticResource BgInput}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="8">
                            <TextBox x:Name="QuestionInputBox" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="Transparent" Foreground="{StaticResource TextMain}" BorderThickness="0" Padding="10" FontSize="13" />
                        </Border>

                        <!-- Process Button -->
                        <Button Grid.Row="2" x:Name="ProcessBtn" Content="⚡ Process Question &amp; Blink Caps Lock" Background="{StaticResource AccentGreen}" Foreground="White" FontWeight="Bold" FontSize="13" Height="36" Margin="0,10,0,10" Click="ProcessBtn_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Results Split View -->
                        <Grid Grid.Row="3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Parsed Structure Preview -->
                            <Border Grid.Column="0" Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,8,0">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <TextBlock Text="PARSED STRUCTURE &amp; OPTIONS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentBlue}" Margin="0,0,0,8" />
                                        <TextBlock x:Name="ParsedStemBlock" Text="Question stem will appear here..." TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource TextMain}" Margin="0,0,0,10" />
                                        <TextBlock Text="DETECTED OPTIONS:" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextDim}" Margin="0,0,0,4" />
                                        <TextBlock x:Name="ParsedOptionsBlock" Text="Options will appear here..." TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource TextDim}" FontFamily="Consolas" />
                                    </StackPanel>
                                </ScrollViewer>
                            </Border>

                            <!-- AI Reasoning & Verification Card -->
                            <Border Grid.Column="1" Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="8,0,0,0">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <TextBlock Text="AI REASONING &amp; VERIFICATION" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentGreen}" Margin="0,0,0,8" />
                                        <Border x:Name="KeyResultBadge" Background="{StaticResource BgInput}" BorderBrush="{StaticResource AccentGreen}" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,10">
                                            <TextBlock x:Name="KeyResultText" Text="Awaiting input..." FontSize="13" FontWeight="Bold" Foreground="{StaticResource AccentGreen}" />
                                        </Border>
                                        <TextBlock x:Name="AiReasoningBlock" Text="Reasoning details will appear here after evaluation..." TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource TextDim}" />
                                    </StackPanel>
                                </ScrollViewer>
                            </Border>
                        </Grid>
                    </Grid>

                    <!-- History View -->
                    <Grid x:Name="HistoryView" Visibility="Collapsed">
                        <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="8" Padding="14">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="HistoryContainer">
                                    <TextBlock Text="RECENT QUERY HISTORY" FontSize="12" FontWeight="Bold" Foreground="{StaticResource AccentBlue}" Margin="0,0,0,10" />
                                    <TextBlock Text="No past queries in this session." Foreground="{StaticResource TextDim}" FontSize="12" />
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>

                    <!-- Settings View -->
                    <Grid x:Name="SettingsView" Visibility="Collapsed">
                        <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="8" Padding="16">
                            <StackPanel MaxWidth="550" HorizontalAlignment="Left">
                                <TextBlock Text="CONFIGURATION SETTINGS" FontSize="13" FontWeight="Bold" Foreground="{StaticResource AccentBlue}" Margin="0,0,0,14" />

                                <TextBlock Text="Gemini API Key:" FontSize="12" Foreground="{StaticResource TextDim}" Margin="0,0,0,4" />
                                <TextBox x:Name="GeminiKeyBox" Background="{StaticResource BgInput}" Foreground="{StaticResource TextMain}" BorderBrush="{StaticResource BorderColor}" Padding="8" Margin="0,0,0,12" />

                                <TextBlock Text="Gemini Model:" FontSize="12" Foreground="{StaticResource TextDim}" Margin="0,0,0,4" />
                                <TextBox x:Name="GeminiModelBox" Text="gemini-3.5-flash-lite" Background="{StaticResource BgInput}" Foreground="{StaticResource TextMain}" BorderBrush="{StaticResource BorderColor}" Padding="8" Margin="0,0,0,12" />

                                <TextBlock Text="Caps Lock Blink Duration (ms):" FontSize="12" Foreground="{StaticResource TextDim}" Margin="0,0,0,4" />
                                <TextBox x:Name="BlinkDurationBox" Text="250" Background="{StaticResource BgInput}" Foreground="{StaticResource TextMain}" BorderBrush="{StaticResource BorderColor}" Padding="8" Margin="0,0,0,16" />

                                <StackPanel Orientation="Horizontal">
                                    <Button Content="💾 Save Settings" Style="{StaticResource ActionBtnStyle}" Click="SaveSettings_Click" Margin="0,0,10,0" />
                                    <Button Content="💡 Test Caps Lock Pulse" Style="{StaticResource ActionBtnStyle}" Click="TestPulse_Click" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>

            <!-- 3. Status Bar -->
            <Border Grid.Row="2" Background="{StaticResource BgSidebar}" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="StatusBarText" Text="⚡ Ready | Background Tray Mode Active | Hotkeys: Ctrl+Alt+X (Solve), Ctrl+Alt+O (OCR)" FontSize="11" Foreground="{StaticResource TextDim}" VerticalAlignment="Center" Margin="14,0,0,0" />
                    <TextBlock Grid.Column="1" Text="Single Instance (Named Mutex Active)" FontSize="10" Foreground="{StaticResource AccentBlue}" VerticalAlignment="Center" Margin="0,0,14,0" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
